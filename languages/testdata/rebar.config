%% rebar.config
{deps, [
    %% Hex package dependency (latest version or with a specific version)
    lager,
    {jsx, "2.9.0"},

    %% Git dependency with a specific tag
    {cowboy, {git, "https://github.com/ninenines/cowboy.git", {tag, "2.9.0"}}},

    %% Git dependency with a specific branch
    {poolboy, {git, "https://github.com/devinus/poolboy.git", {branch, "master"}}},

    %% Git dependency with a specific commit reference
    {gpb, {git, "https://github.com/tomas-abrahamsson/gpb.git", {ref, "aef728b"}}}
]}.

%% Optional: additional configuration for your project
{erl_opts, [debug_info]}.
{src_dirs, ["src", "include"]}.